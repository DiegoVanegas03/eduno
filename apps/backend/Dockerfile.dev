FROM node:20-alpine

WORKDIR /app

# Enable corepack for pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Instalar dependencias primero para aprovechar la caché de Docker
COPY package.json ./
# Si tienes un pnpm-lock.yaml local también lo copias (o lo excluyes en .dockerignore),
# pero aquí como no habrá node_modules locales forzamos la instalación.
COPY pnpm-lock.yaml* ./
RUN pnpm install

# Copiar el resto del código
COPY . .

# Comando por defecto (modo dev con node --watch)
CMD ["pnpm", "run", "dev"]
