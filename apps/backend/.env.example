# ========================================
# Configuración Servidor Express
# ========================================
PORT="3000"
BASE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:4200"

# ========================================
# Configuración MongoDB
# ========================================
MONGO_URI="mongodb://localhost:27017/eduno"

# ========================================
# Configuración MinIO (Almacenamiento)
# ========================================
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="mis-archivos"

# ========================================
# Configuración ClamAV (Antivirus)
# ========================================
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"

# ========================================
# Configuración better-auth
# ========================================
# Genera un secreto aleatorio fuerte: openssl rand -hex 32
BETTER_AUTH_SECRET="cambiame-en-produccion-usa-openssl-rand-hex-32"

# ========================================
# Google OAuth (API Console Credentials)
# ========================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ========================================
# Microsoft OAuth (Azure Portal Credentials)
# ========================================
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"
