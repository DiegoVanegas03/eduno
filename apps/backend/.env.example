# ========================================
# Configuración Servidor Express
# ========================================
PORT="3000"

# ========================================
# Configuración MongoDB
# ========================================
MONGO_URI="mongodb://localhost:27017/mi_base_datos"

# ========================================
# Configuración MinIO (Almacenamiento)
# ========================================
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="mis-archivos"

# ========================================
# Configuración ClamAV (Antivirus)
# ========================================
CLAMAV_HOST="localhost"
CLAMAV_PORT="3310"

# ========================================
# Configuración Autenticación JWT
# ========================================
JWT_SECRET="mi_super_secreto_super_seguro_cambiame_en_prod"
JWT_EXPIRES_IN="30d"

# ========================================
# Google OAuth (API Console Credentials)
# ========================================
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ========================================
# Microsoft OAuth (Azure Portal Credentials)
# ========================================
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
